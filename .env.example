# ============================================================================
# Werefa — environment reference. Copy to .env and fill in values.
# NEVER commit real credentials. All values here are placeholders for local dev.
# ============================================================================

# ---- App --------------------------------------------------------------------
# development | test | production (gates migration/seed behavior)
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Africa/Addis_Ababa
PORT=3000

# ---- PostgreSQL -------------------------------------------------------------
# Runtime (API): role "app" — RLS-enforced.
DATABASE_URL=postgresql://app:b3Jvbi1jYW4tYHBnLWFwcA@localhost:5433/werefa
# Migrations / maintenance: role "migrator" — bypasses RLS, no login from app.
DATABASE_MIGRATOR_URL=postgresql://migrator:6c731077f9c94b2ebcbb8d75d6e6e6e6@localhost:5433/werefa
# DDL bootstrap / test DB re-creation: superuser (local dev only).
DATABASE_URL_SUPERUSER=postgresql://postgres:dev-postgres-password-change-me@localhost:5433/werefa
TEST_DB_NAME=werefa_test

# ---- Redis / BullMQ ---------------------------------------------------------
REDIS_URL=redis://localhost:6379
JOB_QUEUE_NAME=werefa-jobs

# ---- Object storage (S3-compatible, MinIO in dev) ---------------------------
STORAGE_PROVIDER=memory        # memory | s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=werefa-private
S3_BUCKET_PUBLIC=werefa-public
S3_ACCESS_KEY_ID=werefa-minio
S3_SECRET_ACCESS_KEY=dev-minio-password-change-me
S3_FORCE_PATH_STYLE=true

# ---- Mail -------------------------------------------------------------------
MAIL_PROVIDER=mailhog        # mailhog | ses | smtp
MAIL_FROM=no-reply@werefa.local

# ---- Security ---------------------------------------------------------------
# Cookie name/attributes for sessions.
SESSION_COOKIE_NAME=wrf.sid
SESSION_TTL_MINUTES=20160   # 14 days
COOKIE_SECURE=true          # set false only for local http dev/tests
# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Auth endpoints rate limiting (login / reset request / reset complete)
AUTH_RATE_LIMIT_MAX=40
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Emergency recovery strict rate limiting
RECOVERY_RATE_LIMIT_MAX=3
RECOVERY_RATE_LIMIT_WINDOW_MS=900000
# Identity behaviour
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RESET_TOKEN_TTL_MINUTES=30
RECOVERY_CODE_TTL_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PUBLIC_BASE_URL=http://localhost:5173
# SMTP (mailhog via SMTP_HOST/PORT for MAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- Observability (optional in dev) -----------------------------------------
# SENTRY_DSN=

# ---- Telegram (not consumed in foundation; declared for config completeness) ----
# TG_BOT_TOKEN=
# TG_WEBHOOK_SECRET=