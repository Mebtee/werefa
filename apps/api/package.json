{
  "name": "@werefa/api",
  "version": "0.1.0",
  "private": true,
  "description": "Werefa REST API (NestJS) — implementation foundation",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker:dev": "NODE_ENV=development tsx src/worker.ts",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run db:test:setup --workspace @werefa/db && vitest run test/integration",
    "seed:dev": "tsx src/seed/dev-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^1.8.3",
    "@prisma/client": "^6.1.0",
    "@werefa/db": "file:../../packages/db",
    "@werefa/shared": "file:../../packages/shared",
    "bullmq": "^5.30.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "pg": "^8.13.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.1"
  }
}
