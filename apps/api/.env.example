# Local environment (git-ignored). Copy from .env.example or infra defaults.
# For local dev you typically want: `docker compose -f infra/docker-compose.yml up -d`
# then apply migrations and RLS via the npm scripts, then `npm run dev:api`.

APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Africa/Addis_Ababa
PORT=3000

DATABASE_URL=postgresql://app:dev-app-password@localhost:5433/werefa
DATABASE_MIGRATOR_URL=postgresql://migrator:dev-migrator-password@localhost:5433/werefa
DATABASE_URL_SUPERUSER=postgresql://postgres:dev-postgres-password-change-me@localhost:5433/werefa

REDIS_URL=redis://localhost:6379
JOB_QUEUE_NAME=werefa-jobs

STORAGE_PROVIDER=memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=werefa-private
S3_BUCKET_PUBLIC=werefa-public
S3_ACCESS_KEY_ID=werefa-minio
S3_SECRET_ACCESS_KEY=dev-minio-password-change-me
S3_FORCE_PATH_STYLE=true

MAIL_PROVIDER=mailhog
MAIL_FROM=no-reply@werefa.local

SESSION_COOKIE_NAME=wrf.sid
SESSION_TTL_MINUTES=20160
COOKIE_SECURE=false

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000