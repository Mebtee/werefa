{
  "name": "werefa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Werefa backend — NestJS modular monolith (API server). See docs/WEREFA-COMPLETE-SPECIFICATION.md for the canonical product specification.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "nest build",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.{ts,js}\" --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/run-db-tests.mjs",
    "prisma:generate": "prisma generate",
    "prisma:dev": "node scripts/prisma-migrate.mjs dev",
    "prisma:deploy": "node scripts/prisma-migrate.mjs deploy",
    "prisma:status": "node scripts/prisma-migrate.mjs status",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:provision": "node scripts/db-provision.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.9.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.28.0",
    "globals": "^16.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.2"
  }
}
