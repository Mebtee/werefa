# =============================================================================
# Werefa backend — environment template
# Copy to `.env` and fill in values. Real credentials are NEVER committed.
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false

# CORS origins allowed by the API (comma-separated). Use explicit origins in
# development; never '*' together with credentialed sessions.
CORS_ORIGINS=http://localhost:5173

# Maximum accepted JSON request body size (NestJS/Express json limit).
BODY_LIMIT=1mb

# Trust proxy headers only when running behind a reverse proxy (never in dev).
TRUST_PROXY=false

# Test auth context: when enabled (non-production), X-Actor-Role + X-Actor-Id
# headers resolve an ActorContext. NEVER enable in production.
AUTH_TEST_ENABLED=false

# ---- Database (see docker-compose.dev.yml; host port 5433) -----------------
# Runtime 'app' role: SELECT/INSERT/UPDATE/DELETE with RLS enforced (doc 07).
DATABASE_URL=postgresql://werefa_app:werefa_app_dev_password@localhost:5433/werefa_dev

# Postgres superuser used only by provisioning scripts (dev only).
POSTGRES_USER=werefa
POSTGRES_PASSWORD=werefa_dev_password

# Migrator role password (DDL only; bypasses RLS; CREATEDB for shadow DB).
MIGRATOR_DATABASE_URL=postgresql://werefa_migrator:werefa_migrator_dev_password@localhost:5433/werefa_dev
MIGRATOR_PASSWORD=werefa_migrator_dev_password

# Test database (created by db-provision.sh; used by gated DB integration tests).
TEST_DATABASE_URL=postgresql://werefa_app:werefa_app_dev_password@localhost:5433/werefa_test

# Run the DB-gated integration suite (requires provisioned test DB).
RUN_DB_TESTS=false

# ---- Product parameters (PENDING SPECIFICATION CLARIFICATION — spec §46) ----
# The six items below are genuinely unresolved product decisions. Implementation
# exposes them as configuration ONLY; it must not invent values. Each stays
# unset (empty/null) until the Product Owner confirms the value.
#
# 1. Subscription monthly price (REQ-125) — no numeric value defined anywhere.
PRODUCT_SUBSCRIPTION_MONTHLY_PRICE_MINOR=
# 2. Global timezone identity (REQ-222) — architecture default recorded below,
#    awaiting product confirmation (spec §46 item 2).
#    Africa/Addis_Ababa is the architecture's design default, not a product fact.
PRODUCT_APP_TIMEZONE=Africa/Addis_Ababa
# 3. Subscription-reminder lead time (REQ-139) — default 3 days is a config
#    parameter pending confirmation (spec §46 item 3).
PRODUCT_REMINDER_LEAD_DAYS=
# 4. Owner booking-report PDF export (spec §46 item 4) — pending clarification.
PRODUCT_OWNER_BOOKING_REPORT_PDF_ENABLED=
# 5. Owner "modify" scope incl. services/components (spec §46 item 5) — pending.
PRODUCT_OWNER_BOOKING_MODIFY_COMPONENTS=
# 6. Dashboard timezone-abbreviation display (BR-32 / spec §46 item 6) — pending.
PRODUCT_SHOW_TIMEZONE_ABBREVIATION=