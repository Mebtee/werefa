{
  "name": "werefa",
  "private": true,
  "version": "0.1.0",
  "description": "Werefa — multi-tenant SaaS scheduling platform (implementation foundation)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace @werefa/db",
    "db:roles": "npm run db:roles --workspace @werefa/db",
    "db:rls": "npm run db:rls --workspace @werefa/db",
    "db:test:setup": "npm run db:test:setup --workspace @werefa/db",
    "bootstrap-dev-db": "npm run db:roles && npm run db:migrate && npm run db:rls",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:worker": "npm run start:worker:dev --workspace apps/api",
    "dev:dashboard": "npm run dev --workspace apps/dashboard",
    "dev:public": "npm run dev --workspace apps/public",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0"
  }
}
