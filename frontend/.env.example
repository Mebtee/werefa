# =============================================================================
# Werefa frontend — environment template (Prompt 44)
# Copy to `.env.local` (never commit real values) and adjust per environment.
#
# Only `VITE_`-prefixed variables are exposed to the browser bundle. NEVER put
# backend secrets, database URLs, tokens or credentials here — anything with a
# `VITE_` prefix is public.
# =============================================================================

# Base URL of the Werefa backend API, including the `/api/v1` prefix.
# Development fallback when unset: http://localhost:3000/api/v1
# Production builds REQUIRE an explicit value (no localhost fallback).
VITE_API_BASE_URL=http://localhost:3000/api/v1
