# Production build default: Vercel proxies /api/* to the Render backend
# (see frontend/vercel.json), so the browser talks to the API same-origin and
# the session cookie stays first-party. If the Vercel project defines
# VITE_API_BASE_URL, that value overrides this file — change it to /api/v1.
VITE_API_BASE_URL=/api/v1
